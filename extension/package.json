{
  "name": "vaultwares-zipper-extension",
  "version": "1.60.0",
  "private": true,
  "type": "module",
  "description": "Firefox/Chrome MV3 extension: Live-stream downloader running along a local companion python server",
  "scripts": {
    "build": "node build.mjs",
    "build:verify": "node build.mjs --no-version-bump",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:ranking && npm run check:zip && npm run check:segments",
    "check:ranking": "esbuild checks/ranking.check.ts --bundle --platform=node --format=esm --outfile=dist/ranking.check.mjs --log-level=warning && node dist/ranking.check.mjs",
    "check:zip": "esbuild checks/zip.check.ts --bundle --platform=node --format=esm --outfile=dist/zip.check.mjs --log-level=warning && node dist/zip.check.mjs",
    "check:segments": "esbuild checks/segments.check.ts --bundle --platform=node --format=esm --outfile=dist/segments.check.mjs --log-level=warning && node dist/segments.check.mjs",
    "start:firefox": "web-ext run --source-dir dist --browser-console",
    "lint": "web-ext lint --source-dir dist",
    "xpi": "web-ext build --source-dir dist --artifacts-dir dist-xpi --overwrite-dest"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "web-ext": "^10.6.0"
  }
}
