{
  "manifest_version": 3,
  "name": "Zip it — Live Stream Grabber (VaultWares)",
  "version": "1.20.0",
  "description": "Live stream (HLS/DASH/MSS) detector that forwards captures — with their real request headers — to the local python-zipper server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zipper-vdh@vaultwares",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "notifications",
    "downloads",
    "tabs",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Stream Grabber",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}